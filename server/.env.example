# Server port
PORT=5000

# MongoDB connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/letztalk
MONGO_URI=

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed client origin(s) for CORS — comma-separated for multiple
# Example: http://localhost:5173,https://letztalk.example.com
CLIENT_ORIGIN=http://localhost:5173

# Node environment: development | production
NODE_ENV=development
